                <mean>0.0</mean>
                <stddev>0.00637</stddev>
              </noise>
            </y>
            <z>
              <noise type="gaussian">
                <mean>0.0</mean>
                <stddev>0.00686</stddev>
              </noise>
            </z>
          </linear_acceleration>
        </imu>
      </sensor>
      <sensor name="navsat_sensor" type="navsat">
        <always_on>1</always_on>
        <update_rate>30</update_rate>
      </sensor>
    </link>
    <plugin filename="libvtol_plant.so" name="vtol::Plant">
      <link_name>base_link</link_name>
      <command_timeout_s>0.5</command_timeout_s>
    </plugin>
  </model>
</sdf>